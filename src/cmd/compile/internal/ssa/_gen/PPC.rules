// Lowering rules for GOARCH=ppc (32-bit PowerPC, the scalar G3 baseline).
//
// The 64-bit operations are not lowered here. The generic dec64 decomposition
// (decompose.go / _gen/dec64.rules) has already turned every 64-bit value into a
// (hi, lo) pair of 32-bit values before this file runs, including the arithmetic
// for Add64/Sub64/Mul64/shifts and the big-endian load and store split, so the
// rules below only have to give the 32-bit residue a machine form.
//
// The carry is the part that is not mechanical. XER[CA] is a single machine bit
// that the pair (addc, adde) shares through, and no instruction can read or write
// it directly, so:
//
//   - Add32carry becomes ADDC, whose second result is the carry as an SSA value
//     of type Flags;
//   - Add32withcarry takes that Flags value as an explicit third argument and
//     becomes ADDE. The Flags argument is a real data dependence, so a scheduler
//     cannot move an unrelated instruction between the addc and the adde; and
//   - every op that writes CA is marked clobberFlags in _gen/PPCOps.go, so the
//     flag allocator treats a carry as destroyed by an instruction that does not
//     produce it, and recomputes it (flagalloc's copyFlags) if one lands in
//     between. That is the whole XER[CA] model; DESIGN.md §5 names addic, srawi,
//     sraw, the subfc family and adde as the clobbering forms.

// Lowering arithmetic.
(Add(Ptr|32|16|8) x y) => (ADD x y)
(Add32carry x y) => (ADDC x y)
(Add32withcarry x y c) => (ADDE x y c)
(Add32carrywithcarry x y c) => (ADDEC x y c)
(Sub(32|16|8) x y) => (SUB x y)
(Sub32carry x y) => (SUBC x y)
(Sub32withcarry x y c) => (SUBE x y c)
(Mul(32|16|8) x y) => (MULLW x y)
(Hmul32 x y) => (MULHW x y)
(Hmul32u x y) => (MULHWU x y)
(Mul32uhilo x y) => (MULLU x y)
// The frontend inserts the divisor-zero check. DIVW also handles -1,
// avoiding the architecturally undefined MinInt32/-1 hardware quotient.
(Div32 x y) => (DIVW x y)
(Div32u x y) => (DIVWU x y)
(Mod32 x y) => (SUB x (MULLW <typ.Int32> y (DIVW <typ.Int32> x y)))
(Mod32u x y) => (SUB x (MULLW <typ.UInt32> y (DIVWU <typ.UInt32> x y)))
(RotateLeft32 x y) => (ROTLW x y)
(And(32|16|8|B) x y) => (AND x y)
(Or(32|16|8|B) x y) => (OR x y)
(Xor(32|16|8) x y) => (XOR x y)
(Neg(32|16|8) x) => (NEG x)
(Com(32|16|8) x) => (XOR x (MOVWconst [-1]))
(Not x) => (XOR x (MOVWconst [1]))

// PPC examines only the low six count bits. Guard the complete Go count:
// counts >= 64 must not wrap back to a small machine shift.
(Lsh32x32 x y) => (AND (SLW <typ.UInt32> x y) (NEG <typ.UInt32> (LessThan (CMPWUconst [32] y))))
(Rsh32Ux32 x y) => (AND (SRW <typ.UInt32> x y) (NEG <typ.UInt32> (LessThan (CMPWUconst [32] y))))
(Rsh32x32 x y) => (SRAW x (OR <typ.UInt32> y (NEG <typ.UInt32> (GreaterEqual (CMPWUconst [32] y)))))
(Lsh32x(8|16) x y) => (Lsh32x32 x (ZeroExt(8|16)to32 y))
(Rsh32Ux(8|16) x y) => (Rsh32Ux32 x (ZeroExt(8|16)to32 y))
(Lsh(8|16)x32 x y) => (Lsh32x32 x y)
(Rsh(8|16)Ux32 x y) => (Rsh32Ux32 (ZeroExt(8|16)to32 x) y)
(Lsh(8|16)x(8|16) x y) => (Lsh32x32 x (ZeroExt(8|16)to32 y))
(Lsh8x16 x y) => (Lsh32x32 x (ZeroExt16to32 y))
// opt canonicalizes constant counts to Const64 after dec64 has run.
(Lsh(8|16|32)x64 x (Const64 [c])) && uint64(c) < 32 => (SLW x (MOVWconst [int32(c)]))
(Lsh(8|16|32)x64 _ (Const64 [c])) && uint64(c) >= 32 => (MOVWconst [0])
(Rsh(8|16)Ux64 x (Const64 [c])) && uint64(c) < 32 => (SRW (ZeroExt(8|16)to32 x) (MOVWconst [int32(c)]))
(Rsh32Ux64 x (Const64 [c])) && uint64(c) < 32 => (SRW x (MOVWconst [int32(c)]))
(Rsh(8|16|32)Ux64 _ (Const64 [c])) && uint64(c) >= 32 => (MOVWconst [0])
(Rsh32x64 x (Const64 [c])) && uint64(c) < 32 => (SRAWI x [int32(c)])
(Rsh32x64 x (Const64 [c])) && uint64(c) >= 32 => (SRAWI x [31])

// Lowering addresses, loads and stores. A 64-bit load or store has already been
// split into two big-endian 32-bit accesses by _gen/dec64.rules, so every case
// here is at most register width.
(OffPtr [off] ptr) => (MOVWaddr [int32(off)] ptr)
(Addr {sym} base) => (MOVWaddr {sym} base)
(LocalAddr <t> {sym} base mem) && t.Elem().HasPointers() => (MOVWaddr {sym} (SPanchored base mem))
(LocalAddr <t> {sym} base _) && !t.Elem().HasPointers() => (MOVWaddr {sym} base)

(Load <t> ptr mem) && t.IsBoolean() => (MOVBUload ptr mem)
(Load <t> ptr mem) && is8BitInt(t) && t.IsSigned() => (MOVBload ptr mem)
(Load <t> ptr mem) && is8BitInt(t) && !t.IsSigned() => (MOVBUload ptr mem)
(Load <t> ptr mem) && is16BitInt(t) && t.IsSigned() => (MOVHload ptr mem)
(Load <t> ptr mem) && is16BitInt(t) && !t.IsSigned() => (MOVHUload ptr mem)
(Load <t> ptr mem) && (is32BitInt(t) || isPtr(t)) => (MOVWload ptr mem)

(Store {t} ptr val mem) && t.Size() == 1 => (MOVBstore ptr val mem)
(Store {t} ptr val mem) && t.Size() == 2 => (MOVHstore ptr val mem)
(Store {t} ptr val mem) && t.Size() == 4 && !t.IsFloat() => (MOVWstore ptr val mem)

// Lowering constants and register moves.
(Const(8|16) [c]) => (MOVWconst [int32(c)])
(Const32 [c]) => (MOVWconst [c])
(ConstBool [t]) => (MOVWconst [b2i32(t)])
(ConstNil) => (MOVWconst [0])
(Copy x) => (MOVWreg x)

// Comparisons use word forms: the 32-bit backend has no 64-bit GPR compare.
// PPC's signed and unsigned compares set different CR0 LT/GT bits, unlike
// architectures whose flags can be interpreted in either signedness.
(Eq32 x y) => (Equal (CMPW x y))
(Neq32 x y) => (NotEqual (CMPW x y))
(Less32 x y) => (LessThan (CMPW x y))
(Leq32 x y) => (LessEqual (CMPW x y))
(Less32U x y) => (LessThan (CMPWU x y))
(Leq32U x y) => (LessEqual (CMPWU x y))

(If (Equal cc) yes no) => (EQ cc yes no)
(If (NotEqual cc) yes no) => (NE cc yes no)
(If (LessThan cc) yes no) => (LT cc yes no)
(If (LessEqual cc) yes no) => (LE cc yes no)
(If (GreaterThan cc) yes no) => (GT cc yes no)
(If (GreaterEqual cc) yes no) => (GE cc yes no)
(If cond yes no) => (NE (CMPWconst [0] cond) yes no)
// Blocks are rewritten before their values. The catch-all can therefore wrap
// a generic comparison before it becomes a predicate; remove that wrapper on
// the next iteration, just as PPC64 does for its boolean test.
(NE (CMPWconst [0] ((Equal|NotEqual|LessThan|LessEqual|GreaterThan|GreaterEqual) cc)) yes no) => ((EQ|NE|LT|LE|GT|GE) cc yes no)
(EQ (FlagEQ) yes no) => (First yes no)
(EQ (FlagLT) yes no) => (First no yes)
(EQ (FlagGT) yes no) => (First no yes)
(NE (FlagEQ) yes no) => (First no yes)
(NE (FlagLT) yes no) => (First yes no)
(NE (FlagGT) yes no) => (First yes no)
(LT (FlagEQ) yes no) => (First no yes)
(LT (FlagLT) yes no) => (First yes no)
(LT (FlagGT) yes no) => (First no yes)
(LE (FlagEQ) yes no) => (First yes no)
(LE (FlagLT) yes no) => (First yes no)
(LE (FlagGT) yes no) => (First no yes)
(GT (FlagEQ) yes no) => (First no yes)
(GT (FlagLT) yes no) => (First no yes)
(GT (FlagGT) yes no) => (First yes no)
(GE (FlagEQ) yes no) => (First yes no)
(GE (FlagLT) yes no) => (First no yes)
(GE (FlagGT) yes no) => (First yes no)
(LT (InvertFlags cmp) yes no) => (GT cmp yes no)
(GT (InvertFlags cmp) yes no) => (LT cmp yes no)
(LE (InvertFlags cmp) yes no) => (GE cmp yes no)
(GE (InvertFlags cmp) yes no) => (LE cmp yes no)
(EQ (InvertFlags cmp) yes no) => (EQ cmp yes no)
(NE (InvertFlags cmp) yes no) => (NE cmp yes no)

(CMPW (MOVWconst [c]) y) && is16Bit(int64(c)) => (InvertFlags (CMPWconst y [int32(c)]))
(CMPWU (MOVWconst [c]) y) && isU16Bit(int64(c)) => (InvertFlags (CMPWUconst y [int32(c)]))
(CMPW x (MOVWconst [c])) && is16Bit(int64(c)) => (CMPWconst x [int32(c)])
(CMPWU x (MOVWconst [c])) && isU16Bit(int64(c)) => (CMPWUconst x [int32(c)])
((CMPW|CMPWU) x y) && canonLessThan(x,y) => (InvertFlags ((CMPW|CMPWU) y x))
(CMPWconst (MOVWconst [x]) [y]) && int32(x)==int32(y) => (FlagEQ)
(CMPWconst (MOVWconst [x]) [y]) && int32(x)<int32(y) => (FlagLT)
(CMPWconst (MOVWconst [x]) [y]) && int32(x)>int32(y) => (FlagGT)
(CMPWUconst (MOVWconst [x]) [y]) && uint32(x)==uint32(y) => (FlagEQ)
(CMPWUconst (MOVWconst [x]) [y]) && uint32(x)<uint32(y) => (FlagLT)
(CMPWUconst (MOVWconst [x]) [y]) && uint32(x)>uint32(y) => (FlagGT)
// Fold known condition codes before a boolean predicate needs a register.
(Equal (FlagEQ)) => (MOVWconst [1])
(Equal (FlagLT)) => (MOVWconst [0])
(Equal (FlagGT)) => (MOVWconst [0])
(NotEqual (FlagEQ)) => (MOVWconst [0])
(NotEqual (FlagLT)) => (MOVWconst [1])
(NotEqual (FlagGT)) => (MOVWconst [1])
(LessThan (FlagEQ)) => (MOVWconst [0])
(LessThan (FlagLT)) => (MOVWconst [1])
(LessThan (FlagGT)) => (MOVWconst [0])
(LessEqual (FlagEQ)) => (MOVWconst [1])
(LessEqual (FlagLT)) => (MOVWconst [1])
(LessEqual (FlagGT)) => (MOVWconst [0])
(GreaterThan (FlagEQ)) => (MOVWconst [0])
(GreaterThan (FlagLT)) => (MOVWconst [0])
(GreaterThan (FlagGT)) => (MOVWconst [1])
(GreaterEqual (FlagEQ)) => (MOVWconst [1])
(GreaterEqual (FlagLT)) => (MOVWconst [0])
(GreaterEqual (FlagGT)) => (MOVWconst [1])
((Equal|NotEqual|LessThan|GreaterThan|LessEqual|GreaterEqual) (InvertFlags x)) => ((Equal|NotEqual|GreaterThan|LessThan|GreaterEqual|LessEqual) x)

// Small values may have unspecified high bits after arithmetic or truncation.
// Mask/extend them before word comparisons and widenings.
(ZeroExt8to(16|32) x) => (AND x (MOVWconst [255]))
(ZeroExt16to32 x) => (AND x (MOVWconst [65535]))
(SignExt8to(16|32) x) => (EXTSB x)
(SignExt16to32 x) => (EXTSH x)
(Trunc(16|32)to8 x) => (Copy x)
(Trunc32to16 x) => (Copy x)
(CvtBoolToUint8 x) => (Copy x)
(Eq(8|16) x y) => (Equal (CMPW (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
(Neq(8|16) x y) => (NotEqual (CMPW (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
(Less(8|16) x y) => (LessThan (CMPW (SignExt(8|16)to32 x) (SignExt(8|16)to32 y)))
(Leq(8|16) x y) => (LessEqual (CMPW (SignExt(8|16)to32 x) (SignExt(8|16)to32 y)))
(Less(8|16)U x y) => (LessThan (CMPWU (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
(Leq(8|16)U x y) => (LessEqual (CMPWU (ZeroExt(8|16)to32 x) (ZeroExt(8|16)to32 y)))
(Eq(Ptr|B) x y) => (Equal (CMPW x y))
(Neq(Ptr|B) x y) => (NotEqual (CMPW x y))
(IsNonNil x) => (NotEqual (CMPWconst [0] x))
(IsInBounds x y) => (LessThan (CMPWU x y))
(IsSliceInBounds x y) => (LessEqual (CMPWU x y))
(Signmask x) => (SRAWI x [31])
(Slicemask x) => (SRAWI (NEG <typ.Int32> x) [31])
(Zeromask x) => (SRAWI (SUB <typ.Int32> (SRW <typ.UInt32> x (MOVWconst [1])) x) [31])
(Avg32u x y) => (ADD (SRW <typ.UInt32> (SUB <typ.UInt32> x y) (MOVWconst [1])) y)
(NilCheck ...) => (LoweredNilCheck ...)
(GetClosurePtr ...) => (LoweredGetClosurePtr ...)
(StaticCall ...) => (CALLstatic ...)
(ClosureCall ...) => (CALLclosure ...)
(InterCall ...) => (CALLinter ...)
(TailCall ...) => (CALLtail ...)
(GetCallerSP ...) => (LoweredGetCallerSP ...)
(GetCallerPC ...) => (LoweredGetCallerPC ...)
(WB ...) => (LoweredWB ...)
(PanicBounds ...) => (LoweredPanicBounds ...)
(PanicExtend ...) => (LoweredPanicExtend ...)

// Generic Move is non-overlapping (or identical); it is not runtime.memmove.
// Write barriers have already been inserted by writebarrier.go before lowering.
(Zero [0] _ mem) => (Copy mem)
(Move [0] _ _ mem) => (Copy mem)
(Zero [s] {t} ptr mem) && s > 0 => (LoweredZero [s] {t} ptr mem)
(Move [s] {t} dst src mem) && s > 0 => (LoweredMove [s] {t} dst src mem)
