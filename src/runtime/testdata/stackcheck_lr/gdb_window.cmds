# gdb witness for goppc-1ye4: park the thread on the instruction right after
# "BL runtime.stackcheck" in main.bigFrame, queue a SIGPROF, and resume.
# Substitute WINDOW_PC (= main.bigFrame + 0x14 from `go tool nm`) and BINARY, then
#   gdb -batch -x gdb_window.cmds ./stackcheck_lr
# Unfixed stackcheck: pc == lr at the breakpoint and the process dies with
# "fatal error: traceback stuck". Fixed: lr is bigFrame's caller and the run completes.
set confirm off
set height 0
handle SIGPROF nostop noprint pass
handle SIGURG nostop noprint pass
handle SIGALRM nostop noprint pass
break *WINDOW_PC
run asm 8 100
info registers pc lr
shell killall -PROF BINARY
delete
continue
